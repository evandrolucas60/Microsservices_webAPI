<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Gateway da intranet (YARP): ponto único de entrada do portal.
    - Serviços da intranet com prefixo por serviço (removido antes de repassar): /auth, /escala, /identidade,
      /documento, /conteudo, /comunicacao (inclui o WebSocket /comunicacao/ws/chat), /comunidades,
      /notificacao, /auditoria e /gc. Sem autorização no gateway (há endpoints anônimos): cada serviço autoriza.
    - Escala 5x2 (solution própria em Escala5x2\Escala5x2.sln): /api/escala5x2/..., exige o JWT da intranet.
    Em todas as rotas: barra usuários bloqueados quando há token válido, responde o CORS e repassa o
    mesmo Authorization (os serviços validam o JWT da intranet por conta própria).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.Shared\BuildingBlocks.Shared.csproj" />
  </ItemGroup>

</Project>
