# Copie para .env (não versionado) no servidor e preencha.

# Imagens publicadas pelo GitHub Actions: ghcr.io/<dono do repositório>
REGISTRY=ghcr.io/evandrolucas60
# latest = último push na main. Para fixar/voltar uma versão: sha-<7 primeiros caracteres do commit>
TAG=latest

# Porta do gateway no servidor
GATEWAY_PORT=5120
# Portal em HTTPS no IIS do 10.11.10.5, que repassa /gateway/... para este gateway (Frontend/public/web.config).
# Troque PORTAL pelo endereço usado no navegador (nome DNS ou 10.11.10.5), sem barra no fim.
# Endereço do gateway visto pelo navegador (URLs absolutas de imagens dos artigos)
PUBLIC_GATEWAY_URL=https://PORTAL/gateway
# Origem do front (esquema://host[:porta]), exatamente como aparece no navegador: CORS, WebSocket do chat e links dos e-mails
FRONTEND_ORIGIN=https://PORTAL

# Compartilhamento das fotos de perfil (\\10.11.10.5\inetpub\wwwroot\intranetManagementFiles\intranet)
# Use aspas simples se a senha tiver $ ou espaço. A senha não pode conter vírgula (vai nas opções do mount CIFS).
SMB_USER=
SMB_PASSWORD=
SMB_DOMAIN=WORKGROUP

# Opcionais
# RABBITMQ_HOST=10.11.10.4
# RABBITMQ_PORT=9000
# LOGIN_RATE_LIMIT=300
